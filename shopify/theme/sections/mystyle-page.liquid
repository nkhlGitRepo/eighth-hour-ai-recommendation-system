{%- comment -%}
  MyStyle: one of its three pages, chosen by the "page" setting -- My Style
  (the style profile quiz), My Recommendations or New Releases. They live at
  /collections/all?view=mystyle, ?view=mystyle-recommendations and
  ?view=mystyle-new (templates/collection.mystyle*.json), so they need no store
  pages; everything inside [data-mystyle-view] is drawn by assets/mystyle.js.
{%- endcomment -%}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<div class="mystyle page-width mystyle-page" data-mystyle-page="{{ section.settings.page }}">
  <div data-mystyle-view>
    <noscript><p class="center">My Style needs JavaScript turned on in your browser.</p></noscript>
  </div>
  {%- if section.settings.page == 'style' -%}
    <template data-mystyle-framing>{%- render 'mystyle-framing-guide' -%}</template>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "My Style",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "page",
      "label": "Page",
      "options": [
        { "value": "style", "label": "My Style (style profile)" },
        { "value": "recommendations", "label": "My Recommendations" },
        { "value": "new", "label": "New Releases" }
      ],
      "default": "style"
    }
  ]
}
{% endschema %}
