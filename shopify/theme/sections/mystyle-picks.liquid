{%- comment -%}
  MyStyle: "Picked for you" for the home page (or any page). A signed-in
  customer with a style profile sees her picks; anyone else sees an invitation
  to build one. Drawn by assets/mystyle.js.
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<div class="mystyle mystyle-picks page-width" data-mystyle-picks data-count="{{ section.settings.count }}" hidden>
  <h2 class="title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
  <p data-mystyle-intro></p>
  <ul class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop mystyle-grid" data-mystyle-list></ul>
</div>

<style>
  .mystyle-picks { padding-top: 3rem; padding-bottom: 3rem; }
</style>

{% schema %}
{
  "name": "My Style picks",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Picked for you"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "My Style picks"
    }
  ]
}
{% endschema %}
