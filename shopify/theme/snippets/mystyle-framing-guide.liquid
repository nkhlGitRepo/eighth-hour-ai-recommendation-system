{%- comment -%}
  MyStyle: how to frame the photo, drawn as simple figures (the same drawings as
  the demo quiz). Placed in a <template> on the My Style page and shown on the
  photo step by assets/mystyle.js.
{%- endcomment -%}
<div class="framing-guide">
  <p class="photo-tips-heading">How to frame your photo</p>
  <div class="framing-examples">
    <figure class="framing-example is-good">
      <svg viewBox="0 0 100 170" role="img" aria-label="Correct: the whole body in frame from head to feet, standing straight, facing the camera, arms slightly away from the sides">
        <rect x="4" y="4" width="92" height="162" rx="6" class="frame" />
        <g class="person">
        <circle cx="50" cy="22" r="9" />
        <path d="M37 36 Q50 31 63 36 L60 70 Q63 79 62 88 L38 88 Q37 79 40 70 Z" />
        <line x1="44" y1="86" x2="45" y2="152" class="limb" />
        <line x1="56" y1="86" x2="55" y2="152" class="limb" />
        <line x1="39" y1="39" x2="23" y2="88" class="arm" />
        <line x1="61" y1="39" x2="77" y2="88" class="arm" />
        </g>
        <circle cx="84" cy="16" r="9" class="badge" />
        <path d="M79.5 16.5 L83 20 L89 12.5" class="badge-mark" />
      </svg>
      <figcaption><strong>Like this</strong>Head to feet, facing the camera, arms a little away from your sides</figcaption>
    </figure>
    <figure class="framing-example is-caution">
      <svg viewBox="0 0 100 170" role="img" aria-label="Works, but may be less accurate: hands on hips cover the sides of the hips and waist">
        <rect x="4" y="4" width="92" height="162" rx="6" class="frame" />
        <g class="person">
        <circle cx="50" cy="22" r="9" />
        <path d="M37 36 Q50 31 63 36 L60 70 Q63 79 62 88 L38 88 Q37 79 40 70 Z" />
        <line x1="44" y1="86" x2="45" y2="152" class="limb" />
        <line x1="56" y1="86" x2="55" y2="152" class="limb" />
        <polyline points="39,39 23,60 40,74" class="arm" />
        <polyline points="61,39 77,60 60,74" class="arm" />
        </g>
        <circle cx="84" cy="16" r="9" class="badge" />
        <path d="M84 11 L84 17.5 M84 20.5 L84 21" class="badge-mark" />
      </svg>
      <figcaption><strong>Hands on hips</strong>Still works, but your hands cover the sides of your hips and waist, so it may be less accurate</figcaption>
    </figure>
    <figure class="framing-example is-bad">
      <svg viewBox="0 0 100 170" role="img" aria-label="Avoid: standing side-on to the camera">
        <rect x="4" y="4" width="92" height="162" rx="6" class="frame" />
        <g class="person">
          <circle cx="52" cy="22" r="9" />
          <path d="M45 35 Q53 33 57 36 Q61 52 58 70 Q62 80 60 88 L45 88 Q43 70 45 35 Z" />
          <line x1="51" y1="86" x2="51" y2="152" class="limb" />
          <line x1="51" y1="39" x2="53" y2="88" class="arm" />
        </g>
        <circle cx="84" cy="16" r="9" class="badge" />
        <path d="M80.5 12.5 L87.5 19.5 M87.5 12.5 L80.5 19.5" class="badge-mark" />
      </svg>
      <figcaption><strong>Turned sideways</strong>We need to see your width, so face the camera</figcaption>
    </figure>
    <figure class="framing-example is-bad">
      <svg viewBox="0 0 100 170" role="img" aria-label="Avoid: too close, so the photo stops at the waist">
        <defs><clipPath id="framingCrop"><rect x="4" y="4" width="92" height="162" rx="6" /></clipPath></defs>
        <rect x="4" y="4" width="92" height="162" rx="6" class="frame frame-fill" />
        <g class="person" clip-path="url(#framingCrop)">
          <g transform="translate(-45 -14) scale(1.9)">
        <circle cx="50" cy="22" r="9" />
        <path d="M37 36 Q50 31 63 36 L60 70 Q63 79 62 88 L38 88 Q37 79 40 70 Z" />
        <line x1="44" y1="86" x2="45" y2="152" class="limb" />
        <line x1="56" y1="86" x2="55" y2="152" class="limb" />
        <line x1="39" y1="39" x2="23" y2="88" class="arm" />
        <line x1="61" y1="39" x2="77" y2="88" class="arm" />
          </g>
        </g>
        <rect x="4" y="4" width="92" height="162" rx="6" class="frame frame-edge" />
        <circle cx="84" cy="16" r="9" class="badge" />
        <path d="M80.5 12.5 L87.5 19.5 M87.5 12.5 L80.5 19.5" class="badge-mark" />
      </svg>
      <figcaption><strong>Too close</strong>Step back until your hips and legs are in the shot</figcaption>
    </figure>
  </div>
  <p class="photo-tips-heading framing-subheading">What to wear</p>
  <div class="framing-examples framing-clothing">
    <figure class="framing-example is-good">
      <svg viewBox="0 0 100 170" role="img" aria-label="Best: fitted clothing, so the outline of the waist and hips is visible">
        <rect x="4" y="4" width="92" height="162" rx="6" class="frame" />
        <g class="person">
          <circle cx="50" cy="22" r="9" />
          <path d="M37 36 Q50 31 63 36 L59 66 Q57 70 59 74 Q63 81 62 88 L38 88 Q37 81 41 74 Q43 70 41 66 Z" />
          <line x1="44" y1="86" x2="45" y2="152" class="limb" />
          <line x1="56" y1="86" x2="55" y2="152" class="limb" />
          <line x1="39" y1="39" x2="23" y2="88" class="arm" />
          <line x1="61" y1="39" x2="77" y2="88" class="arm" />
        </g>
        <circle cx="84" cy="16" r="9" class="badge" />
        <path d="M79.5 16.5 L83 20 L89 12.5" class="badge-mark" />
      </svg>
      <figcaption><strong>Fitted clothing</strong>Leggings and a fitted top let us see your waist</figcaption>
    </figure>
    <figure class="framing-example is-caution">
      <svg viewBox="0 0 100 170" role="img" aria-label="Works, but less accurate: loose clothing hides the waist">
        <rect x="4" y="4" width="92" height="162" rx="6" class="frame" />
        <g class="person">
          <circle cx="50" cy="22" r="9" />
          <path d="M37 36 Q50 31 63 36 L70 128 Q50 134 30 128 Z" />
          <line x1="45" y1="126" x2="45" y2="152" class="limb" />
          <line x1="55" y1="126" x2="55" y2="152" class="limb" />
          <line x1="39" y1="39" x2="23" y2="88" class="arm" />
          <line x1="61" y1="39" x2="77" y2="88" class="arm" />
        </g>
        <circle cx="84" cy="16" r="9" class="badge" />
        <path d="M84 11 L84 17.5 M84 20.5 L84 21" class="badge-mark" />
      </svg>
      <figcaption><strong>Loose clothing</strong>Still works, but hides your waist, so that estimate is less accurate</figcaption>
    </figure>
  </div>
</div>
